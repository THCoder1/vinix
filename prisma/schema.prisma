generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VehicleStatus {
  PURCHASED
  IN_PREPARATION
  READY_FOR_SALE
  RESERVED
  SOLD
  HOLD
  CANCELLED
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  PLUG_IN_HYBRID
  ELECTRIC
  LPG
  OTHER
}

enum ExpenseCategory {
  MECHANICAL
  PARTS
  TYRES
  BODYWORK
  PAINT
  DETAILING
  ITV
  GESTORIA
  REGISTRATION
  TRANSPORT
  WARRANTY
  OTHER
}

enum DocumentType {
  AUCTION_INVOICE
  PURCHASE_INVOICE
  TRANSPORT_INVOICE
  WORKSHOP_INVOICE
  REGISTRATION
  ITV
  WARRANTY
  SALES_INVOICE
  OTHER
}

enum OcrStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVIEW_REQUIRED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
}

enum UserRole {
  ADMIN
  MANAGER
  SALES
  VIEWER
}

enum VehicleEventType {
  VEHICLE_CREATED
  ACQUISITION_CREATED
  AUCTION_INVOICE_UPLOADED
  ACQUISITION_APPROVED
  EXPENSE_ADDED
  PRICE_CHANGED
  STATUS_CHANGED
  VEHICLE_RESERVED
  VEHICLE_SOLD
  DOCUMENT_UPLOADED
}

model Vehicle {
  id                String        @id @default(cuid())
  vin               String        @unique
  registration      String?
  make              String
  model             String
  version           String?
  firstRegistration DateTime?
  mileage           Int?
  fuel              FuelType?
  engine            String?
  transmission      String?
  colour            String?
  status            VehicleStatus @default(PURCHASED)
  location          String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  acquisitions Acquisition[]
  expenses     Expense[]
  documents    Document[]
  sales        Sale[]
  events       VehicleEvent[]
  photos       VehiclePhoto[]

  @@index([status])
  @@index([make, model])
  @@index([registration])
}

model User {
  id         String   @id @default(cuid())
  authUserId String   @unique
  email      String   @unique
  name       String?
  role       UserRole @default(SALES)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  events VehicleEvent[]
}

model Acquisition {
  id            String    @id @default(cuid())
  vehicleId     String    @unique
  supplier      String?
  auctionHouse  String?
  invoiceNumber String?
  invoiceDate   DateTime?
  approvedAt    DateTime?
  purchasePrice Decimal   @db.Decimal(12, 2)
  auctionFee    Decimal   @default(0) @db.Decimal(12, 2)
  transportCost Decimal   @default(0) @db.Decimal(12, 2)
  taxCost       Decimal   @default(0) @db.Decimal(12, 2)
  otherCost     Decimal   @default(0) @db.Decimal(12, 2)
  currency      String    @default("EUR")
  documentId    String?   @unique
  createdAt     DateTime  @default(now())

  vehicle  Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([invoiceNumber])
}

model Expense {
  id            String          @id @default(cuid())
  vehicleId     String
  category      ExpenseCategory
  description   String
  supplier      String?
  invoiceNumber String?
  amount        Decimal         @db.Decimal(12, 2)
  taxAmount     Decimal         @default(0) @db.Decimal(12, 2)
  date          DateTime        @default(now())
  documentId    String?         @unique
  createdAt     DateTime        @default(now())

  vehicle  Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([category])
  @@index([date])
}

model Document {
  id          String       @id @default(cuid())
  vehicleId   String
  type        DocumentType
  filename    String
  storagePath String
  mimeType    String
  source      String?
  ocrStatus   OcrStatus    @default(PENDING)
  uploadedAt  DateTime     @default(now())

  vehicle     Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  acquisition Acquisition?
  expense     Expense?
  sale        Sale?

  @@index([vehicleId])
  @@index([type])
  @@index([ocrStatus])
}

model Sale {
  id            String        @id @default(cuid())
  vehicleId     String        @unique
  saleDate      DateTime?
  salePrice     Decimal       @db.Decimal(12, 2)
  invoiceNumber String?
  paymentStatus PaymentStatus @default(PENDING)
  documentId    String?       @unique
  createdAt     DateTime      @default(now())

  vehicle  Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([saleDate])
}

model VehicleEvent {
  id          String           @id @default(cuid())
  vehicleId   String
  eventType   VehicleEventType
  description String?
  userId      String?
  createdAt   DateTime         @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([vehicleId, createdAt])
  @@index([userId])
}

model VehiclePhoto {
  id          String   @id @default(cuid())
  vehicleId   String
  storagePath String
  url         String?
  sortOrder   Int      @default(0)
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([vehicleId, sortOrder])
}
